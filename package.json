{
    "name": "starter-template",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "packageManager": "pnpm@10.17.0",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "node --disable-warning=ExperimentalWarning source/database/local/server.ts migrate && vite dev --port 3000",
        "build": "NODE_ENV=production vite build",
        "start": "node --disable-warning=ExperimentalWarning --import ./source/tracing.ts source/node.ts",
        "preview": "DATABASE_URL=$(node --disable-warning=ExperimentalWarning source/database/local/server.ts url) PORT=3001 pnpm start",
        "format": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "workbench/scripts/check.sh",
        "smoke-test": "node workbench/scripts/smoke-test.mjs",
        "github:ruleset": "workbench/scripts/ruleset.sh",
        "database:generate": "drizzle-kit generate",
        "database:check": "workbench/scripts/check-migrations.sh",
        "database:upgrade-test": "workbench/scripts/upgrade-test.sh",
        "database:migrate": "node --disable-warning=ExperimentalWarning source/database/migrate.ts",
        "database:seed": "node --disable-warning=ExperimentalWarning source/database/local/server.ts migrate && node workbench/scripts/seed.mjs",
        "database:sql": "node --disable-warning=ExperimentalWarning source/database/local/server.ts sql",
        "database:reset": "node --disable-warning=ExperimentalWarning source/database/local/server.ts reset",
        "database:stop": "node --disable-warning=ExperimentalWarning source/database/local/server.ts stop"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@dbos-inc/dbos-sdk": "5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@hono/node-server": "^2.1.5",
        "@hono/zod-validator": "^0.9.1",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/context-async-hooks": "^3.1.1",
        "@opentelemetry/core": "^3.1.1",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
        "@opentelemetry/instrumentation": "^0.301.2",
        "@opentelemetry/instrumentation-http": "^0.301.2",
        "@opentelemetry/instrumentation-pg": "^0.78.0",
        "@opentelemetry/instrumentation-undici": "^0.35.1",
        "@opentelemetry/resources": "^3.1.1",
        "@opentelemetry/sdk-trace": "^3.1.1",
        "@opentelemetry/semantic-conventions": "^1.45.0",
        "@superforge/infra": "^0.5.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-router": "^1.170.45",
        "@tanstack/react-start": "^1.169.3",
        "aws4fetch": "^1.0.20",
        "bowser": "2.15.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.13",
        "import-in-the-middle": "^3.6.0",
        "isbot": "5.2.3",
        "lucide-react": "^1.61.0",
        "maxmind": "5.1.0",
        "pg": "^8.23.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "shadcn": "^4.22.1",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.2",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "drizzle-kit": "^0.31.11",
        "embedded-postgres": "18.4.0-beta.17",
        "railway": "^3.16.0",
        "squawk-cli": "2.68.0",
        "typescript": "^6.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
